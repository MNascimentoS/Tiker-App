<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/defaultPadding"
    android:background="?selectableItemBackground">

    <TextView
        android:id="@+id/packageNameTXT"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3sp"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toStartOf="@+id/removePackageBTN"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Cubos" />

    <TextView
        android:id="@+id/packageAuthorTXT"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2sp"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toStartOf="@+id/removePackageBTN"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/packageNameTXT"
        tools:text="Mr. menezes • 735 kb" />

    <Button
        android:id="@+id/removePackageBTN"
        style="@style/MyDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:elevation="18dp"
        android:padding="4dp"
        android:text="@string/label_remove"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/packageAuthorTXT">

        <br.com.tiker.views.GridViewItem
            android:id="@+id/stickerIMG1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            tools:src="@tools:sample/backgrounds/scenic"/>

        <br.com.tiker.views.GridViewItem
            android:id="@+id/stickerIMG2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            tools:src="@tools:sample/backgrounds/scenic"/>

        <br.com.tiker.views.GridViewItem
            android:id="@+id/stickerIMG3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            tools:src="@tools:sample/backgrounds/scenic"/>

        <br.com.tiker.views.GridViewItem
            android:id="@+id/stickerIMG4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            tools:src="@tools:sample/backgrounds/scenic"/>

        <br.com.tiker.views.GridViewItem
            android:id="@+id/stickerIMG5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            tools:src="@tools:sample/backgrounds/scenic"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>